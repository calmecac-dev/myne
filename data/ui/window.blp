// SPDX-License-Identifier: GPL-3.0-or-later
// Myne: main window.
// Requires libadwaita >= 1.5 and GtkSourceView 5.
//
// Actions the window must register ("win." prefix):
//   open, save, save-as, compile, zoom-in, zoom-out, zoom-fit, prev-page,
//   next-page, clear-log, hide-log, open-log (simple actions)
//   show-log (boolean stateful action; drives the status button and the Revealer)
// Application actions ("app." prefix): preferences, help, about, quit
// Shortcuts: win.open Ctrl+O, win.save Ctrl+S, win.save-as Ctrl+Shift+S,
//   win.compile F5, win.show-log Ctrl+Shift+L, win.zoom-in Ctrl++,
//   win.zoom-out Ctrl+-, win.zoom-fit Ctrl+0, app.preferences Ctrl+, ,
//   win.show-help-overlay Ctrl+?, app.quit Ctrl+Q
//
// Compilation status: set status_stack.visible-child-name to
//   "busy" | "ok" | "warning" | "error", status_count.label to the number of
//   warnings, and banner.revealed = true only when the compilation fails.
using Gtk 4.0;
using Adw 1;
using GtkSource 5;

menu primary_menu {
  section {
    item {
      label: _("Preferences");
      action: "app.preferences";
    }

    item {
      label: _("Keyboard shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("Help");
      action: "app.help";
    }

    item {
      label: _("About Myne");
      action: "app.about";
    }
  }
}

template $MyneWindow: Adw.ApplicationWindow {
  title: "Myne";
  default-width: 1100;
  default-height: 700;
  width-request: 360;
  height-request: 480;

  // In narrow windows the editor and the viewer are stacked.
  Adw.Breakpoint {
    condition ("max-width: 780sp")

    setters {
      paned.orientation: vertical;
    }
  }

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button open_button {
        action-name: "win.open";
        tooltip-text: _("Open (Ctrl+O)");

        child: Adw.ButtonContent {
          icon-name: "myne-open-symbolic";
          label: _("Open");
        };
      }

      [start]
      Button save_button {
        action-name: "win.save";
        icon-name: "myne-save-symbolic";
        tooltip-text: _("Save (Ctrl+S)");

        accessibility {
          label: _("Save");
        }
      }

      [title]
      Adw.WindowTitle window_title {
        title: "document.mom";
        subtitle: "~/Documents";
      }

      // The first [end] child sits at the far right.
      [end]
      MenuButton primary_menu_button {
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
        primary: true;
        tooltip-text: _("Main menu");

        accessibility {
          label: _("Main menu");
        }
      }

      // Compilation status; also shows and hides the log.
      [end]
      ToggleButton log_button {
        action-name: "win.show-log";
        tooltip-text: _("Compilation log (Ctrl+Shift+L)");

        accessibility {
          label: _("Compilation log");
        }

        child: Box {
          spacing: 6;

          // The first page is the one visible by default.
          Stack status_stack {
            StackPage {
              name: "ok";

              child: Image {
                icon-name: "emblem-ok-symbolic";
                styles ["success"]
              };
            }

            StackPage {
              name: "busy";

              child: Spinner {
                spinning: true;
              };
            }

            StackPage {
              name: "warning";

              child: Image {
                icon-name: "dialog-warning-symbolic";
                styles ["warning"]
              };
            }

            StackPage {
              name: "error";

              child: Image {
                icon-name: "dialog-error-symbolic";
                styles ["error"]
              };
            }
          }

          Label status_count {
            visible: false;
            styles ["numeric"]
          }
        };
      }
    }

    content: Box {
      orientation: vertical;

      Paned paned {
        vexpand: true;
        orientation: horizontal;
        position: 540;
        resize-start-child: true;
        resize-end-child: true;
        shrink-start-child: false;
        shrink-end-child: false;

        // Editor
        start-child: Overlay {
          child: ScrolledWindow {
            width-request: 280;

            child: GtkSource.View source_view {
              show-line-numbers: true;
              highlight-current-line: true;
              monospace: true;
              top-margin: 10;
              bottom-margin: 10;

              buffer: GtkSource.Buffer source_buffer {};
            };
          };

          [overlay]
          Label position_label {
            halign: end;
            valign: end;
            margin-end: 12;
            margin-bottom: 10;
            label: _("Line 1, col. 1");
            can-target: false;
            styles ["caption", "dim-label", "numeric"]
          }
        };

        // PDF viewer
        end-child: Overlay {
          child: Box {
            orientation: vertical;

            Adw.Banner banner {
              title: _("Compilation failed. The last good version is shown.");
              button-label: _("View log");
              action-name: "win.open-log";
              revealed: false;
            }

            ScrolledWindow pdf_scroller {
              width-request: 280;
              vexpand: true;
              hexpand: true;

              // Custom widget: draws the pages of the PDF.
              child: $MynePdfView pdf_view {};
            }
          };

          // Zoom and page controls, floating over the viewer.
          [overlay]
          Box {
            halign: center;
            valign: end;
            margin-bottom: 16;
            spacing: 4;
            styles ["osd", "toolbar"]

            Button {
              action-name: "win.zoom-out";
              icon-name: "zoom-out-symbolic";
              tooltip-text: _("Zoom out (Ctrl+−)");

              accessibility {
                label: _("Zoom out");
              }
            }

            Label zoom_label {
              label: "100 %";
              width-chars: 5;
              styles ["numeric"]
            }

            Button {
              action-name: "win.zoom-in";
              icon-name: "zoom-in-symbolic";
              tooltip-text: _("Zoom in (Ctrl++)");

              accessibility {
                label: _("Zoom in");
              }
            }

            Separator {
              orientation: vertical;
            }

            Button {
              action-name: "win.zoom-fit";
              icon-name: "zoom-fit-best-symbolic";
              tooltip-text: _("Fit to width (Ctrl+0)");

              accessibility {
                label: _("Fit to width");
              }
            }

            Separator {
              orientation: vertical;
            }

            Button {
              action-name: "win.prev-page";
              icon-name: "go-previous-symbolic";
              tooltip-text: _("Previous page");

              accessibility {
                label: _("Previous page");
              }
            }

            Label page_label {
              label: "1 / 1";
              styles ["numeric"]
            }

            Button {
              action-name: "win.next-page";
              icon-name: "go-next-symbolic";
              tooltip-text: _("Next page");

              accessibility {
                label: _("Next page");
              }
            }
          }
        };
      }

      // Compilation log: hidden by default.
      Revealer log_revealer {
        reveal-child: bind log_button.active;
        transition-type: slide_up;

        child: Box {
          orientation: vertical;

          Separator {}

          Box {
            margin-start: 14;
            margin-end: 6;
            margin-top: 4;
            margin-bottom: 4;
            spacing: 6;

            Label {
              hexpand: true;
              halign: start;
              label: _("Compilation log");
              styles ["heading"]
            }

            Button {
              action-name: "win.clear-log";
              icon-name: "edit-clear-all-symbolic";
              tooltip-text: _("Clear log");
              styles ["flat"]

              accessibility {
                label: _("Clear log");
              }
            }

            Button {
              action-name: "win.hide-log";
              icon-name: "go-down-symbolic";
              tooltip-text: _("Hide log (Ctrl+Shift+L)");
              styles ["flat"]

              accessibility {
                label: _("Hide log");
              }
            }
          }

          Separator {}

          ScrolledWindow {
            min-content-height: 160;

            // One row per groff message (Adw.ActionRow created from Rust).
            child: ListBox log_list {
              selection-mode: none;
            };
          }
        };
      }
    };
  };
}
