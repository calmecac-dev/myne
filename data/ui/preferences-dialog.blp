// Myne: preferences dialog (changes apply at once, there is no save button).
// Requires libadwaita >= 1.5. Each row is bound to Config in src/preferences.rs.
using Gtk 4.0;
using Adw 1;

template $MynePreferencesDialog: Adw.PreferencesDialog {
  title: _("Preferences");

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      Adw.ComboRow language_row {
        title: _("Language");
        subtitle: _("Applies after restarting Myne");

        // Same order as LANGUAGES in src/preferences.rs. Each language is
        // named in itself, so anyone can find theirs.
        model: StringList {
          strings [_("System language"), "English", "Español"]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Compilation");

      Adw.SwitchRow compile_on_save {
        title: _("Compile on save");
        subtitle: _("Runs pdfmom every time you save the document");
      }

      Adw.EntryRow command_row {
        title: _("Command");
        text: "pdfmom";
      }
    }

    Adw.PreferencesGroup {
      title: _("Preprocessors");
      description: _("groff programs applied before typesetting the document.");

      Adw.SwitchRow tbl_row {
        title: _("Tables");
        subtitle: _("tbl, option -t");
      }

      Adw.SwitchRow eqn_row {
        title: _("Equations");
        subtitle: _("eqn, option -e");
      }

      Adw.SwitchRow pic_row {
        title: _("Images and diagrams");
        subtitle: _("pic, option -p");
      }

      Adw.SwitchRow refer_row {
        title: _("Bibliography");
        subtitle: _("refer, option -R");
      }
    }

    Adw.PreferencesGroup {
      title: _("Log");

      Adw.SwitchRow show_log_on_error {
        title: _("Show on errors");
        subtitle: _("Opens the log automatically if compilation fails");
      }
    }
  }
}
