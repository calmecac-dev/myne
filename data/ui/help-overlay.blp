// Myne: keyboard shortcuts window (win.show-help-overlay).
using Gtk 4.0;

ShortcutsWindow help_overlay {
  modal: true;

  ShortcutsSection {
    section-name: "shortcuts";

    ShortcutsGroup {
      title: _("Document");

      ShortcutsShortcut {
        title: _("Open");
        action-name: "win.open";
      }

      ShortcutsShortcut {
        title: _("Save");
        action-name: "win.save";
      }

      ShortcutsShortcut {
        title: _("Save as");
        action-name: "win.save-as";
      }

      ShortcutsShortcut {
        title: _("Compile without saving");
        action-name: "win.compile";
      }
    }

    ShortcutsGroup {
      title: _("Preview");

      ShortcutsShortcut {
        title: _("Zoom in");
        action-name: "win.zoom-in";
      }

      ShortcutsShortcut {
        title: _("Zoom out");
        action-name: "win.zoom-out";
      }

      ShortcutsShortcut {
        title: _("Fit to width");
        action-name: "win.zoom-fit";
      }
    }

    ShortcutsGroup {
      title: _("General");

      ShortcutsShortcut {
        title: _("Show or hide the log");
        action-name: "win.show-log";
      }

      ShortcutsShortcut {
        title: _("Preferences");
        action-name: "app.preferences";
      }

      ShortcutsShortcut {
        title: _("Keyboard shortcuts");
        action-name: "win.show-help-overlay";
      }

      ShortcutsShortcut {
        title: _("Quit");
        action-name: "app.quit";
      }
    }
  }
}
